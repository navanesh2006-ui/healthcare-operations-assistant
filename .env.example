# CareBridge Real Email & System Configuration
PROJECT_NAME="CareBridge: Agentic Hospital Discharge & Follow-up Coordinator"
SECRET_KEY="your-secret-key-here"

# Database Configuration (Defaults to SQLite for local development, PostgreSQL in Docker)
DATABASE_URL="sqlite:///./carebridge.db"

# Public Application URL (used for single-use email action links e.g. http://localhost:3000 or public ngrok/cloudflare tunnel)
PUBLIC_BASE_URL="http://localhost:3000"

# Real Gmail SMTP Provider Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=your-email@example.com
SMTP_PASSWORD=
SMTP_FROM_NAME="CareBridge"

# Demo Hospital Target Mailbox (All hospital-bound emails are routed here)
HOSPITAL_DEMO_EMAIL=hospital@example.com

# AI Provider Configuration
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
EMBEDDING_MODEL=text-embedding-004
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

